# Copier en .env.local et remplir. Ne jamais committer de vraies valeurs.

# --- Supabase (mini-CMS, voir docs/cms.md) ---
# Valeurs publiques, protégées par le RLS. Sans clé : le site affiche les valeurs du code.
NEXT_PUBLIC_SUPABASE_URL=https://vlpevjffaqzvksjfknhk.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Uniquement pour `npm run test:cms` en local (jamais sur Vercel) : le site n'en a pas besoin.
SUPABASE_SECRET_KEY=
# Compte éditeur (présent dans cms_editors) utilisé par le test du CMS.
CMS_TEST_EDITOR_EMAIL=

# --- SimplyBook (API côté serveur uniquement) ---
# API REST publique (docs/simplybook/README.md) : clé « Clé API REST publique »
SIMPLYBOOK_API_HOST=https://user-api-v2.simplybook.it
SIMPLYBOOK_COMPANY=horizondessens
SIMPLYBOOK_API_KEY=

# --- Stripe (cartes cadeaux, voir src/lib/gift-card/) ---
# Clés de test (sk_test_…) en local et en Preview, live en Production.
STRIPE_SECRET_KEY=
# Secret de l'endpoint webhook /api/stripe/webhook (whsec_…), un par endpoint.
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Resend (formulaire de contact et envoi des cartes cadeaux) ---
RESEND_API_KEY=
# Expéditeur sur le domaine vérifié dans Resend
CONTACT_FROM_EMAIL="Horizon des Sens <contact@horizondessens.fr>"
# Destinataire (par défaut : l'e-mail d'Élodie, src/lib/site.ts)
CONTACT_TO_EMAIL=e.nguyen@horizondessens.fr

# --- SimplyBook API admin (serveur uniquement, scripts de gestion des prestations) ---
# Login de l'utilisateur SimplyBook pour qui la clé a été créée (page « API User Keys »)
SIMPLYBOOK_ADMIN_LOGIN=
# Clé d'utilisateur API, commence par api_user_key_
SIMPLYBOOK_ADMIN_API_KEY=
